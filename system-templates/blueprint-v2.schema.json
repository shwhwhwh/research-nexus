                  "required": [
                    "op",
                    "settings"
                  ],
                  "properties": {
                    "op": {
                      "type": "string",
                      "enum": [
                        "input",
                        "http_get",
                        "http_post",
                        "select",
                        "map",
                        "filter",
                        "dedupe",
                        "write_json",
                        "write_markdown",
                        "builtin_archive",
                        "orx_citations",
                        "alpha_project_library",
                        "zotero_project_notes"
                      ]
                    },
                    "settings": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
